# Build from the repository root:  docker build -f backend/dockerfile .
FROM node:24-slim AS base
ENV PNPM_HOME="/pnpm"
ENV PATH="$PNPM_HOME:$PATH"
RUN corepack enable
WORKDIR /repo
COPY pnpm-workspace.yaml package.json pnpm-lock.yaml .node-version ./
COPY packages/shared/package.json packages/shared/
COPY backend/package.json backend/

# Production dependencies only (no dev dependencies in the final image).
FROM base AS prod-deps
RUN --mount=type=cache,id=pnpm,target=/pnpm/store \
    pnpm install --prod --frozen-lockfile --filter two-cents-backend...

FROM base AS build
RUN --mount=type=cache,id=pnpm,target=/pnpm/store \
    pnpm install --frozen-lockfile --filter two-cents-backend...
COPY packages/shared packages/shared
COPY backend backend
RUN pnpm --filter @two-cents/shared build && pnpm --filter two-cents-backend build

# Same folder layout as the workspace, so the @two-cents/shared link resolves.
FROM node:24-slim
ENV NODE_ENV=production
WORKDIR /repo
COPY --from=prod-deps /repo/node_modules ./node_modules
COPY --from=prod-deps /repo/packages/shared/node_modules ./packages/shared/node_modules
COPY --from=prod-deps /repo/backend/node_modules ./backend/node_modules
COPY --from=build /repo/packages/shared/package.json ./packages/shared/package.json
COPY --from=build /repo/packages/shared/dist ./packages/shared/dist
COPY --from=build /repo/backend/package.json ./backend/package.json
COPY --from=build /repo/backend/dist ./backend/dist
COPY --from=build /repo/backend/drizzle ./backend/drizzle
WORKDIR /repo/backend
EXPOSE 3000
USER node
CMD ["node", "dist/main.js"]
