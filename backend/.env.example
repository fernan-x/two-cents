# Copy to .env and fill in. Never commit .env.
NODE_ENV=development
PORT=3000
DATABASE_URL=postgres://two_cents:two_cents@localhost:5442/two_cents
# 32+ random bytes, base64. Generate with: openssl rand -base64 32
JWT_SECRET=
# 32 random bytes, base64 (AES-256-GCM key for the Apple refresh token)
TOKEN_ENCRYPTION_KEY=
# 32+ random bytes, base64 (HMAC key for hashing IPs in security events)
IP_HASH_KEY=
SMTP_URL=smtp://localhost:1025
MAIL_FROM="Two Cents <no-reply@example.com>"
# Base of links sent by email (universal links in production, twocents:// in dev)
APP_LINK_BASE_URL=twocents://
APPLE_TEAM_ID=
APPLE_KEY_ID=
# Contents of the .p8 key, with literal \n for newlines
APPLE_PRIVATE_KEY=
APPLE_BUNDLE_ID=
GOOGLE_WEB_CLIENT_ID=
# Set to true behind a reverse proxy so rate limits use the client IP
TRUST_PROXY=false
# SHA-256 fingerprint of the Android app signing certificate (App Links)
ANDROID_CERT_SHA256=
